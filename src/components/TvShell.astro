---
import channelsData from '../data/channels.json';

const channels = channelsData.channels.filter((channel) => channel.enabled !== false);
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section class="reader" id="reader">
  <header class="reader-head">
    <div>
      <p class="eyebrow">REDROCK · FRIEND READER</p>
      <h1>友链阅读器</h1>
      <p>左侧浏览 RSS 文章，点击后在新标签页打开原文；右侧保留网站缓存预览。</p>
    </div>
    <label class="channel-select">
      <span>当前频道</span>
      <select id="channel-select">
        {channels.map((channel, index) => (
          <option value={channel.id}>
            {String(index + 1).padStart(2, '0')} · {channel.name}
          </option>
        ))}
      </select>
    </label>
  </header>

  <nav class="channel-tabs" id="channel-tabs" aria-label="博客频道">
    {channels.map((channel, index) => (
      <button class="channel-tab" data-id={channel.id} type="button">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{channel.name}</strong>
        {!channel.rssUrl && <small>仅预览</small>}
      </button>
    ))}
  </nav>

  <div class="workspace" id="workspace">
    <aside class="feed-pane" id="feed-pane" aria-label="RSS 文章列表">
      <header class="feed-head">
        <div>
          <p class="pane-label">RSS ARTICLES</p>
          <h2 id="feed-title">文章</h2>
        </div>
        <a id="rss-link" href="#" target="_blank" rel="noopener" title="打开 RSS">RSS ↗</a>
      </header>

      <div class="feed-body">
        <div class="feed-loading" id="feed-loading" role="status">
          <span></span><span></span><span></span>
          <p>正在读取 RSS 缓存…</p>
        </div>
        <div class="feed-error" id="feed-error" hidden>
          <strong>RSS 缓存暂不可用</strong>
          <p id="feed-error-message">请稍后再试。</p>
        </div>
        <div class="article-list" id="article-list" aria-live="polite"></div>
      </div>

      <footer class="feed-foot">
        <span id="article-count">— 篇</span>
        <span id="rss-cache-time">缓存读取中…</span>
      </footer>
    </aside>

    <section class="preview-pane" aria-label="网站缓存预览">
      <header class="preview-toolbar">
        <div class="preview-heading">
          <p class="pane-label">CACHED PREVIEW</p>
          <strong id="preview-title">网站首页</strong>
        </div>
        <div class="preview-actions">
          <button id="preview-home" type="button" title="返回镜像首页" aria-label="返回镜像首页">⌂</button>
          <button id="preview-back" type="button" title="后退" aria-label="后退">←</button>
          <button id="preview-forward" type="button" title="前进" aria-label="前进">→</button>
          <button id="preview-refresh" type="button" title="刷新" aria-label="刷新">↻</button>
          <a id="origin-link" href="#" target="_blank" rel="noopener">原文 ↗</a>
        </div>
      </header>

      <div class="screen-wrap">
        <div class="screen-loading" id="screen-loading" aria-hidden="true">
          <span id="screen-channel">CH-01</span>
        </div>
        <iframe
          class="screen"
          id="screen"
          title="友链网站缓存预览"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
          referrerpolicy="no-referrer"
        ></iframe>
      </div>

      <footer class="preview-foot">
        <span id="mirror-status">镜像状态读取中…</span>
        <span>静态缓存 · 交互功能可能受限</span>
      </footer>
    </section>
  </div>
</section>

<style is:global>
  .reader {
    --surface: #11151a;
    --surface-2: #171c22;
    max-width: 1120px;
    margin: 0 auto;
  }
  .reader-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }
  .reader-head h1 {
    margin: 3px 0 8px;
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .reader-head > div > p:last-child {
    color: var(--muted);
    font-size: 14px;
  }
  .eyebrow,
  .pane-label {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .channel-select {
    display: grid;
    flex: 0 0 240px;
    gap: 4px;
  }
  .channel-select span {
    color: var(--muted);
    font-size: 10px;
  }
  .channel-select select {
    width: 100%;
    height: 40px;
    padding: 0 34px 0 11px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
  }
  .channel-tabs {
    display: flex;
    gap: 8px;
    padding-bottom: 12px;
    overflow-x: auto;
  }
  .channel-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 7px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }
  .channel-tab:hover,
  .channel-tab.active {
    border-color: var(--accent);
  }
  .channel-tab.active {
    background: rgba(245, 197, 24, 0.08);
  }
  .channel-tab span,
  .channel-tab small {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
  }
  .channel-tab strong {
    font-size: 12px;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(250px, 3fr) minmax(0, 7fr);
    min-height: 640px;
    height: min(76vh, 860px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .workspace.no-rss {
    grid-template-columns: minmax(0, 1fr);
  }
  .workspace.no-rss .feed-pane {
    display: none;
  }
  .feed-pane,
  .preview-pane {
    min-width: 0;
    min-height: 0;
  }
  .feed-pane {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    border-right: 1px solid var(--border);
    background: #0e1115;
  }
  .feed-head,
  .preview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 66px;
    padding: 12px 15px;
    border-bottom: 1px solid var(--border);
  }
  .feed-head h2 {
    margin-top: 2px;
    overflow: hidden;
    font-size: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .feed-head a {
    color: var(--muted);
    font-size: 10px;
  }
  .feed-head a:hover {
    color: var(--accent);
  }
  .article-list {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #343b45 transparent;
  }
  .feed-body {
    min-height: 0;
    overflow: hidden;
  }
  .article-entry {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 10px;
    width: 100%;
    padding: 12px 13px;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .article-entry.no-cover {
    grid-template-columns: 1fr;
  }
  .article-entry:hover {
    background: var(--surface-2);
  }
  .article-thumb {
    width: 72px;
    height: 52px;
    overflow: hidden;
    border-radius: 7px;
    background: #080a0c;
  }
  .article-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-copy {
    min-width: 0;
  }
  .article-date {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
  }
  .article-title {
    display: -webkit-box;
    overflow: hidden;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .article-summary {
    margin-top: 5px;
    overflow: hidden;
    color: var(--muted);
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .feed-foot,
  .preview-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 34px;
    padding: 8px 13px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
  }
  .feed-loading,
  .feed-error {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    color: var(--muted);
    text-align: center;
    font-size: 11px;
  }
  .feed-loading > span {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: feed-pulse 0.8s ease-in-out infinite alternate;
  }
  .feed-loading > span:nth-child(2) {
    animation-delay: 0.16s;
  }
  .feed-loading > span:nth-child(3) {
    animation-delay: 0.32s;
  }
  .feed-error strong {
    color: var(--fg);
  }
  .feed-loading[hidden],
  .feed-error[hidden] {
    display: none;
  }
  .preview-pane {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: #080a0c;
  }
  .preview-toolbar {
    background: var(--surface);
  }
  .preview-heading {
    min-width: 0;
  }
  .preview-heading strong {
    display: block;
    max-width: min(42vw, 460px);
    margin-top: 2px;
    overflow: hidden;
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .preview-actions {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .preview-actions button,
  .preview-actions a {
    display: grid;
    place-items: center;
    height: 30px;
    min-width: 30px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #0d1014;
    color: var(--muted);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .preview-actions button:hover,
  .preview-actions a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .screen-wrap {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .screen-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background: #050607;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
  }
  .screen-loading.on {
    opacity: 1;
  }
  .screen-loading span {
    color: rgba(255, 255, 255, 0.15);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(42px, 9vw, 96px);
    font-weight: 800;
  }
  .preview-foot {
    background: var(--surface);
  }
  @keyframes feed-pulse {
    to {
      opacity: 0.2;
      transform: translateY(-3px);
    }
  }
  @media (max-width: 760px) {
    .reader-head {
      align-items: stretch;
      flex-direction: column;
    }
    .channel-select {
      flex-basis: auto;
    }
    .workspace {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 0;
      overflow: visible;
    }
    .feed-pane {
      height: 360px;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .preview-pane {
      height: 68vh;
      min-height: 520px;
    }
    .workspace.no-rss .preview-pane {
      height: 74vh;
    }
    .preview-heading strong {
      max-width: 38vw;
    }
    .preview-actions a {
      display: none;
    }
  }
</style>

<script define:vars={{ channels, BASE }}>
  const workspace = document.getElementById('workspace');
  const channelSelect = document.getElementById('channel-select');
  const channelTabs = [...document.querySelectorAll('.channel-tab')];
  const feedTitle = document.getElementById('feed-title');
  const rssLink = document.getElementById('rss-link');
  const feedLoading = document.getElementById('feed-loading');
  const feedError = document.getElementById('feed-error');
  const feedErrorMessage = document.getElementById('feed-error-message');
  const articleList = document.getElementById('article-list');
  const articleCount = document.getElementById('article-count');
  const rssCacheTime = document.getElementById('rss-cache-time');
  const screen = document.getElementById('screen');
  const screenLoading = document.getElementById('screen-loading');
  const screenChannel = document.getElementById('screen-channel');
  const previewTitle = document.getElementById('preview-title');
  const originLink = document.getElementById('origin-link');
  const mirrorStatus = document.getElementById('mirror-status');
  const previewHome = document.getElementById('preview-home');
  const previewBack = document.getElementById('preview-back');
  const previewForward = document.getElementById('preview-forward');
  const previewRefresh = document.getElementById('preview-refresh');

  let currentId = new URLSearchParams(location.search).get('ch');
  if (!channels.some((channel) => channel.id === currentId)) currentId = channels[0].id;
  let currentChannel = channels.find((channel) => channel.id === currentId);
  let feedRequest = 0;

  function channelNumber(id) {
    return String(channels.findIndex((channel) => channel.id === id) + 1).padStart(2, '0');
  }

  function mirrorHome(channel = currentChannel) {
    return `${BASE}channels/${channel.id}/`;
  }

  function setPreview(url, title, originalUrl) {
    previewTitle.textContent = title;
    originLink.href = originalUrl || currentChannel.url;
    screenLoading.classList.add('on');
    screen.src = url;
  }

  function selectChannel(id) {
    const channel = channels.find((candidate) => candidate.id === id);
    if (!channel) return;
    currentId = id;
    currentChannel = channel;
    channelSelect.value = id;
    channelTabs.forEach((tab) => {
      const active = tab.dataset.id === id;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-current', active ? 'true' : 'false');
    });
    history.replaceState(null, '', `?ch=${encodeURIComponent(id)}`);
    workspace.classList.toggle('no-rss', !channel.rssUrl);
    screenChannel.textContent = `CH-${channelNumber(id)}`;
    articleList.replaceChildren();
    setPreview(mirrorHome(channel), `${channel.name} · 镜像首页`, channel.url);
    if (channel.rssUrl) loadFeed(channel);
  }

  async function loadFeed(channel) {
    const request = ++feedRequest;
    feedTitle.textContent = channel.name;
    rssLink.href = channel.rssUrl;
    feedLoading.hidden = false;
    feedError.hidden = true;
    articleList.replaceChildren();
    articleCount.textContent = '— 篇';
    rssCacheTime.textContent = '缓存读取中…';
    try {
      const response = await fetch(`${BASE}rss/${channel.id}.json`);
      if (!response.ok) throw new Error(`缓存响应异常（${response.status}）`);
      const feed = await response.json();
      if (request !== feedRequest || currentId !== channel.id) return;
      renderFeed(feed);
    } catch (error) {
      if (request !== feedRequest || currentId !== channel.id) return;
      feedLoading.hidden = true;
      feedError.hidden = false;
      feedErrorMessage.textContent = error.message || '请稍后再试。';
      rssCacheTime.textContent = '缓存不可用';
    }
  }

  function renderFeed(feed) {
    feedLoading.hidden = true;
    const fragment = document.createDocumentFragment();
    for (const item of feed.items || []) {
      const entry = document.createElement('a');
      entry.className = 'article-entry';
      entry.href = item.link;
      entry.target = '_blank';
      entry.rel = 'noopener';

      if (item.image && /^images\/[a-z0-9-]+\/[a-f0-9]+\.(?:avif|gif|jpe?g|png|webp)$/i.test(item.image)) {
        const thumb = document.createElement('span');
        thumb.className = 'article-thumb';
        const image = document.createElement('img');
        image.src = `${BASE}rss/${item.image}`;
        image.alt = '';
        image.loading = 'lazy';
        image.decoding = 'async';
        image.addEventListener('error', () => {
          thumb.remove();
          entry.classList.add('no-cover');
        });
        thumb.append(image);
        entry.append(thumb);
      } else {
        entry.classList.add('no-cover');
      }

      const copy = document.createElement('span');
      copy.className = 'article-copy';
      const date = document.createElement('time');
      date.className = 'article-date';
      date.dateTime = item.publishedAt || '';
      date.textContent = formatDate(item.publishedAt);
      const title = document.createElement('span');
      title.className = 'article-title';
      title.textContent = item.title;
      copy.append(date, title);
      if (item.summary) {
        const summary = document.createElement('span');
        summary.className = 'article-summary';
        summary.textContent = item.summary;
        copy.append(summary);
      }
      entry.append(copy);
      fragment.append(entry);
    }
    articleList.replaceChildren(fragment);
    articleCount.textContent = `${feed.items?.length || 0} 篇`;
    rssCacheTime.textContent = feed.fetchedAt ? formatDateTime(feed.fetchedAt) : '缓存时间未知';
  }

  function formatDate(value) {
    if (!value) return '日期未知';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '日期未知';
    return date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
  }

  function formatDateTime(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '时间未知';
    return `缓存 ${date.toLocaleString('zh-CN', { hour12: false })}`;
  }

  screen.addEventListener('load', () => screenLoading.classList.remove('on'));
  channelSelect.addEventListener('change', () => selectChannel(channelSelect.value));
  channelTabs.forEach((tab) => tab.addEventListener('click', () => selectChannel(tab.dataset.id)));
  previewHome.addEventListener('click', () => {
    setPreview(mirrorHome(), `${currentChannel.name} · 镜像首页`, currentChannel.url);
  });
  previewBack.addEventListener('click', () => {
    try { screen.contentWindow?.history.back(); } catch { /* 镜像导航不可用时忽略 */ }
  });
  previewForward.addEventListener('click', () => {
    try { screen.contentWindow?.history.forward(); } catch { /* 镜像导航不可用时忽略 */ }
  });
  previewRefresh.addEventListener('click', () => {
    screenLoading.classList.add('on');
    screen.src = screen.src;
  });

  fetch(`${BASE}channels/status.json`)
    .then((response) => response.ok ? response.json() : Promise.reject(new Error('状态不可用')))
    .then((status) => {
      const updated = new Date(status.updatedAt).toLocaleString('zh-CN', { hour12: false });
      mirrorStatus.textContent = `镜像同步于 ${updated}`;
    })
    .catch(() => {
      mirrorStatus.textContent = '镜像状态未知';
    });

  selectChannel(currentId);
</script>
