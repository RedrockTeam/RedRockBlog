---
import Base from '../layouts/Base.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<Base title="RedRock">
  <section class="hero">
    <h1>RedRock 友链电视</h1>
    <p>把友链博客镜像成一个个频道，像调台一样快速浏览。</p>
    <a class="cta" href={`${BASE}tv/`}>打开电视</a>
  </section>
  <style>
    .hero {
      max-width: 720px;
      margin: 8vh auto 0;
      text-align: center;
    }
    .hero h1 {
      font-size: 40px;
      letter-spacing: 1px;
      margin: 0 0 16px;
    }
    .hero p {
      color: var(--muted);
      margin: 0 0 28px;
    }
    .cta {
      display: inline-block;
      padding: 12px 28px;
      border-radius: 999px;
      background: var(--accent);
      color: #111;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</Base>
